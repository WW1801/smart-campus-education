<view class="page">
  <view class="hero-card">
    <text class="eyebrow">流程申请</text>
    <text class="hero-title">请假申请</text>
    <text class="hero-subtitle">提交申请并查看我的请假记录，待审批记录支持主动取消</text>
  </view>

  <view class="tabs">
    <button class="tab {{ activeTab === 'form' ? 'active' : '' }}" bindtap="showForm">提交申请</button>
    <button class="tab {{ activeTab === 'records' ? 'active' : '' }}" bindtap="showRecords">我的记录</button>
  </view>

  <view wx:if="{{ activeTab === 'form' }}" class="panel">
    <view class="field">
      <view class="field-label">请假类型</view>
      <picker class="picker" mode="selector" range="{{ leaveTypes }}" range-key="label" value="{{ leaveTypeIndex }}" bindchange="onLeaveTypeChange">
        <view>{{ leaveTypes[leaveTypeIndex].label }}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">学期</view>
      <picker class="picker" mode="selector" range="{{ semesterOptions }}" range-key="name" value="{{ semesterIndex }}" bindchange="onSemesterChange">
        <view>{{ currentSemesterName || "选择学期" }}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">关联课程（可选）</view>
      <picker class="picker" mode="selector" range="{{ courseOptions }}" range-key="name" value="{{ courseIndex }}" bindchange="onCourseChange">
        <view>{{ selectedCourseName || "不关联课程" }}</view>
      </picker>
    </view>
    <view class="field two-cols">
      <view class="date-field">
        <view class="field-label">开始日期</view>
        <picker class="picker" mode="date" value="{{ form.startDate }}" bindchange="onStartDateChange">
          <view>{{ form.startDate || "选择日期" }}</view>
        </picker>
      </view>
      <view class="date-field date-field-right">
        <view class="field-label">结束日期</view>
        <picker class="picker" mode="date" value="{{ form.endDate }}" bindchange="onEndDateChange">
          <view>{{ form.endDate || "选择日期" }}</view>
        </picker>
      </view>
    </view>
    <view class="field">
      <view class="field-label">请假原因（最多 300 字）</view>
      <textarea class="textarea" maxlength="300" value="{{ form.reason }}" placeholder="请填写请假原因" bindinput="onReasonInput" />
    </view>
    <button class="primary-button submit-button" loading="{{ submitting }}" bindtap="submitLeave">提交申请</button>
  </view>

  <view wx:else>
    <button class="secondary-button reload-button" loading="{{ recordsLoading }}" bindtap="loadRecords">刷新记录</button>
    <view wx:if="{{ recordsLoading }}" class="state">
      <text class="state-title">正在加载</text>
      <text class="state-desc">正在读取请假记录</text>
    </view>
    <view wx:elif="{{ recordsError }}" class="state">
      <text class="state-title">请求失败</text>
      <text class="state-desc">{{ recordsError }}</text>
    </view>
    <view wx:elif="{{ records.length === 0 }}" class="state">
      <text class="state-title">暂无记录</text>
      <text class="state-desc">还没有提交过请假申请</text>
    </view>
    <view wx:else class="list">
      <view wx:for="{{ records }}" wx:key="requestId" class="item">
        <view class="item-title">
          {{ item.leaveTypeText }}
          <text class="status {{ item.statusClass }}">{{ item.statusText }}</text>
        </view>
        <view class="item-meta">日期：{{ item.startDate }} 至 {{ item.endDate }}</view>
        <view class="item-meta">课程：{{ item.courseName || "未关联课程" }}</view>
        <view class="item-meta">审批意见：{{ item.processOpinion || "-" }}</view>
        <view class="item-meta">提交时间：{{ item.submittedAt || "-" }}</view>
        <button wx:if="{{ item.status === 'pending' }}" class="danger-button cancel-button" data-id="{{ item.requestId }}" bindtap="cancelLeave">取消申请</button>
      </view>
    </view>
  </view>
</view>
